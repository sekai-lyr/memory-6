<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sekai.game2048.mapper.Sekai2048UserMapper">

    <resultMap id="BaseResultMap" type="com.sekai.game2048.dataobject.Sekai2048UserDO">
        <id property="id" column="id"/>
        <result property="userName" column="username"/>
        <result property="password" column="password"/>
        <result property="nickName" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="vipLevel" column="vip_level"/>
        <result property="vipExpireTime" column="vip_expire_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, username, password, nickname, avatar, vip_level, vip_expire_time, create_time
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM sekai_2048_user
        WHERE id = #{id}
    </select>

    <select id="selectByUserName" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM sekai_2048_user
        WHERE username = #{userName}
        LIMIT 1
    </select>

    <select id="selectByLoginName" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM sekai_2048_user
        WHERE username = #{loginName}
           OR nickname = #{loginName}
        ORDER BY CASE WHEN username = #{loginName} THEN 0 ELSE 1 END, id
        LIMIT 1
    </select>

    <insert id="insert"
            parameterType="com.sekai.game2048.dataobject.Sekai2048UserDO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO sekai_2048_user (username, password, nickname, avatar)
        VALUES (#{userName}, #{password}, #{nickName}, #{avatar})
    </insert>

    <update id="updateByPrimaryKeySelective"
            parameterType="com.sekai.game2048.dataobject.Sekai2048UserDO">
        UPDATE sekai_2048_user
        <set>
            <if test="userName != null">username = #{userName},</if>
            <if test="password != null">password = #{password},</if>
            <if test="nickName != null">nickname = #{nickName},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="vipLevel != null">vip_level = #{vipLevel},</if>
            <if test="vipExpireTime != null">vip_expire_time = #{vipExpireTime},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
